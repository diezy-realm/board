[Unit]
Description=Run the board -> agy bridge (hourly safety net / event driven)

[Timer]
# Hourly passive watchdog safety net (reboot-safe). Active task dispatch is driven
# directly on-time by events (auto-merge / unblock triggers), eliminating the 5-minute polling tax.
OnCalendar=*:00
Persistent=true
Unit=agy-bridge.service

[Install]
WantedBy=timers.target
