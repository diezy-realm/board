[Unit]
Description=Sprint lifecycle: close any ALL-DONE sprint-NN (archive it) and activate sprint-NN+1
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env python3 %h/Apps/board/tools/agy-bridge/board_switch.py sprint
# Pure local file/folder moves (no gh/network calls); cheap, safe to run often.
TimeoutStartSec=60
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
