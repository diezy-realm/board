[Unit]
Description=Board -> agy bridge (standalone, no KiroCrew gateway)
# Needs the network up to push branches / open PRs via gh.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# One poll of the board. The timer re-triggers this every 5 minutes.
ExecStart=/usr/bin/env python3 %h/Apps/board/tools/agy-bridge/run_standalone.py
# agy finishes on its own (`--print-timeout 0`). This is ONLY an anti-wedge net:
# generous enough that a legitimately long task is never killed, but a truly
# stuck run can't block the 5-minute timer forever. 4h.
TimeoutStartSec=14400
# agy needs HOME + PATH for ~/.local/bin/agy and gh.
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
